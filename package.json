{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atelier \u2014 an AI coding agent for design-grade websites (scout \u2192 designer \u2192 coder)",
  "scripts": {
    "build": "tsx src/adapt.ts",
    "audit": "tsx src/audit.ts",
    "render-check": "tsx src/render-audit.ts",
    "wire-check": "tsx src/behavior.ts",
    "clone": "tsx src/clone.ts",
    "swap": "tsx src/swap.ts",
    "name": "tsx src/name.ts",
    "extract": "tsx src/extract.ts",
    "validate": "tsx src/artifact/cli.ts validate",
    "load": "tsx src/artifact/cli.ts load",
    "test": "tsx test/recovery.test.ts && tsx test/artifact.test.ts && tsx test/name.test.ts && tsx test/render.test.ts && tsx test/behavior.test.ts",
    "typecheck": "tsc --noEmit",
    "_retired_build:site": "tsx src/build.ts",
    "_retired_synthesize": "tsx src/synthesize.ts",
    "atelier": "tsx src/cli/main.tsx",
    "ref": "tsx src/reference.ts",
    "outline": "tsx src/outline.ts",
    "scaffold": "tsx src/scaffold-cli.ts",
    "verify-site": "tsx src/verify-site.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "ink": "^8.0.0",
    "playwright": "^1.48.0",
    "react": "^19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "atelier": "bin/atelier"
  }
}
